---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import heroImage from '@images/hero-image66.avif';
import heroDarkImage from '@images/hero-image66.avif';
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import testimonialAvatar from '@images/testis.webp';
import { SEO, SITE, SOCIAL_PREVIEW_IMAGE_URL } from '@/data_files/constants';


// Extend the site-wide structured data with SoftwareApplication (PAVii is a
// downloadable desktop product) and FAQPage schema for the homepage FAQ
// section. Invisible to users; helps search engines and AI assistants.
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    ...SEO.structuredData['@graph'],
    {
      '@type': 'SoftwareApplication',
      name: 'PAVii',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows 10+, macOS 14 (Apple Silicon), Linux x64',
      description:
        'PAVii is a blockchain-based agentic security, LLM security and agentic observability platform. It checks every AI agent call at six security gates, keeps personal data private and records each action on Hyper 0X.',
      url: `${SITE.url}/products/super-assistant/`,
      image: SOCIAL_PREVIEW_IMAGE_URL,
      softwareVersion: '2.0.5',
      author: {
        '@type': 'Organization',
        name: SITE.title,
        url: SITE.url,
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      downloadUrl: [
        'https://github.com/vjk7989/pavii-release/releases/latest/download/PAVii-Windows-x64-setup.exe',
        'https://github.com/vjk7989/pavii-release/releases/latest/download/PAVii-macOS-arm64.dmg',
        'https://github.com/vjk7989/pavii-release/releases/latest/download/PAVii-Linux-x64.AppImage',
        'https://github.com/vjk7989/pavii-release/releases/latest/download/PAVii-Linux-x64.deb',
        'https://github.com/vjk7989/pavii-release/releases/latest/download/PAVii-Linux-x64.rpm',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.faqs.map(faq => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<MainLayout structuredData={homeStructuredData}>
  <!-- <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Explore ScrewFast on GitHub"
    url="https://github.com/mearashadowfax/ScrewFast"
  /> -->

  <HeroSection
    title=`Protect Your AI Agents with <span
        class="text-blue-500 dark:text-blue-400" style="color:#3b82f6;">PAVii.AI</span>`
    subTitle="Blockchain-based security and observability for every AI agent and LLM. Pavii blocks harmful calls, keeps personal data private and records every action on Hyper 0X."
    primaryBtn="Explore Products"
    primaryBtnURL="/products/security/"
    secondaryBtn="Book a Call"
    secondaryBtnURL="https://cal.com/buckleson-group/30min"
    withReview={false}
    src={heroImage}
    darkSrc={heroDarkImage}
    alt="Stack of PAVii.AI product boxes with AI tools"
  />

  <!-- <ClientsSection
    title="Trusted by "
    subTitle="Experience the partnership chosen by best organizations."
    partners={partnersData}
  /> -->

  <FeaturesGeneral
    title="Security for the Age of AI Agents"
    subTitle="AI agents read data, call tools and send messages for you. Pavii checks each of these actions, stops the harmful ones and shows your team what every agent does."
    features={features}
  />

  <FeaturesNavs
    title=`Use any AI in your applications. <span class="text-blue-500 dark:text-blue-400" style="color: #3b82f6;">PAVii.AI</span> protects it.`
    tabs={[
      {
        heading: 'One Gateway for Every Agent',
        content:
          "Connect Claude, Claude Code, Codex, ChatGPT, Grok, OpenCode or your own agents to one gateway. Pavii applies the same rules to every agent and model.",
        svg: 'tools',
        src: tools,
        alt: 'Illustration of AI tools and systems that connect to one gateway',
        first: true,
      },
      {
        heading: 'No Change to Your Business Logic',
        content:
          "Pavii connects to the systems that you use now. Use the Pavii chain, run your rules on-chain or deploy your own chain inside your organization.",
        svg: 'dashboard',
        src: dashboard,
        alt: 'Graphic of a software dashboard',
        second: true,
      },
      {
        heading: 'Private Data and Permanent Records',
        content:
          "The privacy gate removes personal data before a model sees it. Each receipt links to the one before it on Hyper 0X, so nobody can secretly change a record.",
        svg: 'house',
        src: construction,
        alt: 'Steel frame of a building, a symbol of a strong structure',
      },
    ]}
  />

 <TestimonialsSection
title="What Teams Say About PAVii.AI"
subTitle="Teams use Pavii to run AI agents with clear rules, private data and a full record of every action."

testimonials={[
{
content:
'PAVII.AI helped us streamline our AI infrastructure without disrupting our existing systems. The deployment process was smooth, the platform was easy to integrate, and the security-first approach gave us confidence in scaling our operations.',
author: 'DEVARAAYA ATLURI',
role: 'CEO | CaterHealth',
avatarSrc: testimonialAvatar,
},
]}


   statistics={[
  {
    count: '100M+',
    description:
      'AI tokens saved across 82K+ queries',
  },
  {
    count: '6',
    description:
      'security gates on every agent call: injection, privacy, supply chain, budget, egress and output',
  },
  {
    count: '30-60%',
    description:
      'fewer tokens used by agents on one measured Claude Code task',
  },
  {
    count: '1',
    description:
      'gateway for every AI agent and model',
  },
]}
  />

  <!-- <PricingSection pricing={pricing} /> -->

  <FAQ title="Frequently<br />asked questions" faqs={faqs} />

<HeroSectionAlt
  title="Put Every AI Agent Behind One Gateway"
  subTitle="Book a call with the PAVii.AI team. We show you how Pavii protects your agents, your data and your users."
  url="https://cal.com/buckleson-group/30min"
/>
</MainLayout>
