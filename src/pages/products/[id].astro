---
// Import section components
import MainLayout from '@/layouts/MainLayout.astro';
import DownloadAlternatives from '@components/products/DownloadAlternatives.astro';
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';
import FlowStack from '@components/ui/FlowStack.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE, SOCIAL_PREVIEW_IMAGE_URL } from '@data/constants';

// Global declaration for gsap animation library
declare global {
  interface Window {
    gsap: any;
  }
}

// This gets the static paths for all the unique products

export async function getStaticPaths() {
  const productEntries = await getCollection('products', ({ id }) =>
    id.startsWith('en/')
  );
  return productEntries.map(product => {
    const idWithoutLang = product.id.replace(/^en\//, ''); // Remove the "en/" prefix
    return {
      params: { id: idWithoutLang },
      props: { product },
    };
  });
}

const { product } = Astro.props;

const pageTitle: string = `${product.data.title} | ${SITE.title}`;
const metaDescription = product.data.description;
const ogTitle = `${product.data.title} | AI Infrastructure Product | ${SITE.title}`;
const isDevTools = product.id === 'en/dev-tools';
const docsUrl = `/products/${product.id.replace(/^en\//, '')}/docs/`;
// Only the HyperOx page (src/content/products/en/dev-tools.md) offers downloads.
const hasPaviiDownloads = isDevTools;
// One constant to bump on each release. The links below always point at the
// newest release ("latest"), so the file names carry no version.
const hyperoxVersion = '0.1.33';
const hyperoxReleasesUrl = 'https://github.com/buckleson/h0x-ADE-Releases';
const hyperoxDownloadBase = `${hyperoxReleasesUrl}/releases/latest/download`;
const hyperoxDownloads = [
  { key: 'windows', os: 'Windows', detail: 'x64', architecture: 'x86_64', file: 'h0x-ade-windows-x86_64.tar.gz' },
  { key: 'macos', os: 'macOS', detail: 'Apple Silicon', architecture: 'aarch64', file: 'h0x-ade-macos-aarch64.tar.gz' },
  { key: 'linux', os: 'Linux', detail: 'x86_64', architecture: 'x86_64', file: 'h0x-ade-linux-x86_64.tar.gz' },
  { key: 'linux', os: 'Linux', detail: 'ARM64', architecture: 'aarch64', file: 'h0x-ade-linux-aarch64.tar.gz' },
].map(d => ({ ...d, url: `${hyperoxDownloadBase}/${d.file}` }));
const osIcons: Record<string, string> = {
  windows: 'M3 5.5 10.5 4.4v7.1H3V5.5Zm8.5-1.2L21 3v8.5h-9.5V4.3ZM3 12.5h7.5v7.1L3 18.5v-6Zm8.5 0H21V21l-9.5-1.3v-7.2Z',
  macos: 'M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.8-3-.8-1.5 0-2.9.9-3.7 2.2-1.6 2.8-.4 6.8 1.1 9 .8 1.1 1.6 2.3 2.8 2.3 1.1 0 1.5-.7 2.9-.7 1.3 0 1.7.7 2.9.7 1.2 0 2-1.1 2.7-2.2.9-1.2 1.2-2.4 1.2-2.5 0 0-2.500-1-2.500-3.600ZM14.2 5.8c.6-.8 1-1.8.9-2.8-.9 0-2 .6-2.6 1.4-.6.7-1.100 1.7-.9 2.700 1 .1 2-.5 2.600-1.300Z',
  linux: 'M12 2c-2 0-3.500 1.800-3.500 4.100 0 1-.2 1.700-.7 2.500-.6 1-1.300 2.200-1.400 4.400L4.200 17.800c-.4.800 0 1.700.8 2.100.7.300 1.500.1 2-.5.8 1.600 2.700 2.600 5 2.600s4.200-1 5-2.600c.5.600 1.300.8 2 .5.8-.4 1.200-1.300.8-2.100L17.600 13c-.1-2.200-.8-3.400-1.400-4.400-.5-.8-.7-1.500-.7-2.500C15.500 3.800 14 2 12 2Z',
};
const paviiDownloadAnalyticsScript = `
(() => {
  const endpoint = 'https://eu.i.posthog.com/capture/';
  const apiKey = 'phc_yimrxw6UXv4iezUNR7MfzG3rXNPww9psTM757SACa7qg';
  document.querySelectorAll('[data-pavii-download]').forEach(link => {
    link.addEventListener('click', () => {
      const element = link;
      const payload = {
        api_key: apiKey,
        event: 'pavii_download',
        properties: {
          distinct_id: crypto.randomUUID(),
          $process_person_profile: false,
          platform: element.dataset.platform,
          architecture: element.dataset.architecture,
          package_type: element.dataset.package,
          app_version: element.dataset.version,
          source: 'pavii_website',
          telemetry_schema: 1,
        },
      };
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      }).catch(() => {});
    });
  });
})();
`;
const previewAlt = `${product.data.title} ${product.data.tabs[2]?.title ?? 'preview'}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${SITE.url}/products/${product.id.replace(/^en\//, '')}`,
    url: `${SITE.url}/products/${product.id.replace(/^en\//, '')}`,
    name: product.data.title,
    description: product.data.description,
    image: SOCIAL_PREVIEW_IMAGE_URL,
    brand: {
      '@type': 'Brand',
      name: SITE.title,
    },
    category: 'AI infrastructure software',
    audience: {
      '@type': 'Audience',
      audienceType: 'developers, businesses, AI teams, enterprises',
    },
  }}
>
  <div id="overlay" class="fixed inset-0 bg-neutral-200 dark:bg-neutral-800">
  </div>

  <section
    class="mx-auto flex max-w-[85rem] flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div>
      <p
        id="fadeText"
        class="mb-8 max-w-prose font-light text-pretty text-neutral-700 sm:text-xl dark:text-neutral-300"
      >
        {product.data.main.content}
      </p>
    </div>
    <div class="flex flex-col items-center justify-between gap-8 lg:flex-row">
      <div id="fadeInUp" class="w-full min-w-0 flex-1">
        <h1
          class="block text-4xl font-bold tracking-tighter text-neutral-800 sm:text-5xl md:text-6xl lg:text-7xl dark:text-neutral-200"
        >
          {product.data.title}
        </h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-400">
          {product.data.description}
        </p>
        {
          hasPaviiDownloads && (
            <div class="mt-8 w-full max-w-3xl rounded-2xl border border-neutral-200 bg-white/80 p-4 shadow-sm backdrop-blur sm:p-6 dark:border-neutral-700 dark:bg-neutral-900/70" id="download">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h2 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">Download HyperOx</h2>
                <p class="text-sm font-semibold text-neutral-600 dark:text-neutral-400">Version {hyperoxVersion} &middot; early access</p>
              </div>
              <div class="mt-4 grid gap-3 sm:grid-cols-2" data-pavii-os-list>
                {hyperoxDownloads.map(download => (
                  <a
                    href={download.url}
                    download
                    data-pavii-download
                    data-pavii-os={download.key}
                    data-platform={download.key}
                    data-architecture={download.architecture}
                    data-package="tar.gz"
                    data-version={hyperoxVersion}
                    class="group relative flex min-h-14 min-w-0 items-center gap-3 rounded-xl border border-neutral-200 bg-white px-4 py-3 text-neutral-800 shadow-sm transition duration-200 hover:border-blue-400 hover:shadow-md focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden data-[recommended]:border-blue-500 data-[recommended]:bg-blue-500 data-[recommended]:text-white dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-blue-500 dark:focus-visible:ring-blue-800 dark:data-[recommended]:bg-blue-500"
                    aria-label={`Download HyperOx for ${download.os} (${download.detail})`}
                  >
                    <svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={osIcons[download.key]} />
                    </svg>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-bold">{download.os} <span class="font-medium opacity-80">({download.detail})</span></span>
                      <span class="block truncate text-xs opacity-70">{download.file}</span>
                    </span>
                    <span class="hidden shrink-0 rounded-full bg-white/20 px-2 py-0.5 text-xs font-semibold group-data-[recommended]:inline">For your device</span>
                    <svg class="size-5 shrink-0 transition duration-300 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                      <path d="M7 10l5 5 5-5" />
                      <path d="M12 15V3" />
                    </svg>
                  </a>
                ))}
              </div>
              <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">
                Each file has a .minisig signature.
              </p>
              <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
                These are .tar.gz archives. On Windows and macOS the command install is the easiest, because it installs and signs the app for you.
                <a href="#tabs-with-card-4" data-pavii-open-install class="font-medium text-blue-600 underline decoration-blue-300 underline-offset-4 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">Install with a command</a>
              </p>
              <div class="mt-4 border-t border-neutral-200 pt-4 dark:border-neutral-700">
                <p class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">Other ways to install</p>
                <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                  <a href={hyperoxReleasesUrl} class="font-medium text-blue-600 underline decoration-blue-300 underline-offset-4 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">All downloads and releases on GitHub</a>
                  <a href="#tabs-with-card-4" data-pavii-open-install class="font-medium text-blue-600 underline decoration-blue-300 underline-offset-4 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">Install with a command</a>
                </div>
              </div>
              <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
                Enterprise version coming soon: teams and admin controls.
                <a href="https://cal.com/buckleson-group/30min" class="font-medium text-blue-600 underline decoration-blue-300 underline-offset-4 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">Book a demo</a>
              </p>
              <p class="mt-4 max-w-2xl text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
                HyperOx counts downloads by operating system and country. The
                event contains no account details or browsing activity.
              </p>
            </div>
          )
        }
        {!hasPaviiDownloads && (
        <p class="mt-8">
          <PrimaryCTA
            title="Book a call to learn more"
            url="https://cal.com/buckleson-group/30min"
          />
        </p>
        )}
      </div>
      {/*
        `overflow-x-clip` contains the #fadeInMoveRight entrance animation,
        which gsap.set()s the image to x: 300 before sliding it to 0. Untamed,
        that 300px offset extends the scrollable area and the page scrolls
        sideways on a phone for the ~2.5s the timeline runs -- permanently if
        the timeline never runs, because the image keeps the offset while
        sitting at visibility: hidden.

        `clip` rather than `hidden`: it does not create a scroll container, so
        no sticky or fixed descendant changes behaviour. The image now slides in
        from its own right edge instead of from off-screen.
      */}
      {product.data.mainFigure ? (
        <div class="w-full max-w-[680px] shrink-0 overflow-x-clip">
          <div id="fadeInMoveRight"><IsoFigure name={product.data.mainFigure} /></div>
        </div>
      ) : (
      <div class="relative aspect-square w-full max-w-[600px] shrink-0 overflow-x-clip">
        <Image
          id="fadeInMoveRight"
          src={product.data.main.imgMain}
          class="absolute inset-0 size-full object-contain"
          alt={product.data.main.imgAlt}
          format={'avif'}
          loading={'eager'}
        />
      </div>
      )}
    </div>
  </section>

  {product.data.flows?.length ? (
    <section class="mx-auto max-w-[85rem] px-4 pt-6 pb-4 sm:px-6 lg:px-8" aria-labelledby="flows-title">
      <p class="text-sm font-semibold tracking-wide text-blue-600 uppercase dark:text-blue-400">See it work</p>
      <h2 id="flows-title" class="mt-2 max-w-2xl text-3xl font-bold text-balance text-neutral-800 md:text-4xl dark:text-neutral-200">{isDevTools ? 'Follow one agent session through HyperOx' : `Follow one request through ${product.data.title}`}</h2>
      <p class="mt-3 max-w-2xl text-lg text-pretty text-neutral-600 dark:text-neutral-400">{isDevTools ? 'Each step of a session passes through HyperOx. Context is reused, personal data is masked before it leaves your computer, and every step is recorded so you can see what happened.' : 'Each request moves down the layers. A safe request reaches the end. A harmful one stops at the layer that catches it, and you see why.'}</p>
      <div class="mt-8 grid gap-6">
        {product.data.flows.map(name => <FlowStack name={name} />)}
      </div>
      {isDevTools ? (
        <p class="mt-6 max-w-2xl text-sm text-pretty text-neutral-500 dark:text-neutral-400">Token saving, PII masking, observability and Workspaces need an account and are part of the full HyperOx app, which is invite-only (beta). The coding agents, tabs and split panes work without one.</p>
      ) : (
      <p class="mt-6 text-pretty text-neutral-600 dark:text-neutral-400">Rules and receipts live on Hyper 0X, the post-quantum-resistant blockchain from Buckleson. <a href="https://buckleson.com/products/hyper-0x/" class="font-semibold text-blue-600 underline-offset-4 hover:underline dark:text-blue-400">See how Hyper 0X works</a> or read <a href="https://buckleson.com/blog/proof-of-execution-ai/" class="font-semibold text-blue-600 underline-offset-4 hover:underline dark:text-blue-400">why receipts need a blockchain</a>.</p>
      )}
    </section>
  ) : null}

  <div class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 lg:pt-14">
    <nav
      class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0"
      aria-label="Tabs"
      role="tablist"
    >
      {
        product.data.tabs.map((tab, index) => (
          <ProductTabBtn
            title={tab.title}
            id={tab.id}
            dataTab={tab.dataTab}
            first={index === 0}
          />
        ))
      }
    </nav>

    <div class="mt-12 md:mt-16">
      <div id="tabs-with-card-1" role="tabpanel">
        <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
          <div class="grid gap-12 md:grid-cols-2">
            <div class="lg:w-3/4">
              <h2
                class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:leading-tight lg:text-4xl dark:text-neutral-200"
              >
                {product.data.longDescription.title}
              </h2>
              <p
                class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400"
              >
                {product.data.longDescription.subTitle}
              </p>
              <p class="mt-5">
                <PrimaryCTA
                  title={product.data.longDescription.btnTitle}
                  url={product.data.longDescription.btnURL}
                />
                {
                  (
                    <a
                      class="ms-3 inline-flex items-center gap-x-2 rounded-lg px-4 py-3 text-sm font-bold text-neutral-700 outline-hidden ring-zinc-500 transition duration-300 hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-300 dark:ring-zinc-200 dark:hover:text-neutral-400"
                      href={docsUrl}
                      data-astro-reload
                    >
                      Documentation
                    </a>
                  )
                }
              </p>
            </div>

            <div class="space-y-6 lg:space-y-10">
              {
                product.data.descriptionList.map(list => (
                  <div class="flex">
                    <div>
                      <h3 class="text-base font-bold text-neutral-800 sm:text-lg dark:text-neutral-200">
                        {list.title}
                      </h3>
                      <p class="mt-1 text-neutral-600 dark:text-neutral-400">
                        {list.subTitle}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div id="tabs-with-card-2" class="hidden" role="tabpanel">
        <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
          <div class="grid w-full grid-cols-1 gap-x-16 md:grid-cols-2">
            <div class="max-w-md space-y-6">
              {
                product.data.specificationsLeft.map(spec => (
                  <div>
                    <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                      {spec.title}
                    </h3>
                    <p class="text-neutral-600 dark:text-neutral-400">
                      {spec.subTitle}
                    </p>
                  </div>
                ))
              }
            </div>
            {
              product.data.specificationsRight ? (
                <div class="mt-6 max-w-md space-y-6 md:mt-0 md:ml-auto">
                  {product.data.specificationsRight?.map(spec => (
                    <div>
                      <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                        {spec.title}
                      </h3>
                      <p class="text-neutral-600 dark:text-neutral-400">
                        {spec.subTitle}
                      </p>
                    </div>
                  ))}
                </div>
              ) : product.data.tableData ? (
                <div class="mt-6 space-y-6 md:mt-0 md:ml-auto">
                  <div class="flex flex-col">
                    <div class="-m-1.5 overflow-x-auto">
                      <div class="inline-block min-w-full p-1.5 align-middle">
                        <div class="overflow-hidden">
                          <table class="min-w-full divide-y divide-neutral-300 dark:divide-neutral-700">
                            <thead>
                              <tr>
                                {product.data.tableData?.[0].feature?.map(
                                  header => (
                                    <th
                                      scope="col"
                                      class="px-6 py-3 text-start text-xs font-medium text-neutral-500 uppercase dark:text-neutral-500"
                                    >
                                      {header}
                                    </th>
                                  )
                                )}
                              </tr>
                            </thead>
                            <tbody class="divide-y divide-neutral-300 dark:divide-neutral-700">
                              {product.data.tableData?.map(row =>
                                // Wrap each row's content in a separate <tr> element
                                row.description.map(rowData => (
                                  <tr>
                                    {/* Iterate through each cell value in the row's description array */}
                                    {rowData.map(cellValue => (
                                      // Render each cell value in its own <td> element
                                      <td class="px-6 py-4 text-sm font-medium whitespace-nowrap text-neutral-600 dark:text-neutral-400">
                                        {cellValue}
                                      </td>
                                    ))}
                                  </tr>
                                ))
                              )}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ) : null
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="tabs-with-card-3" class="hidden" role="tabpanel">
    {product.data.figures?.length ? (
      <div class="mx-auto mb-20 grid w-full max-w-5xl gap-10 md:mb-28">
        {product.data.figures.map(name => <IsoFigure name={name} />)}
      </div>
    ) : (
    <div class="mx-auto mb-20 flex w-full min-h-[260px] md:mb-28 md:min-h-[420px] 2xl:w-4/5">
      <div
        class="relative top-12 left-12 z-10 aspect-video w-3/5 overflow-hidden rounded-xl shadow-lg md:top-16 md:left-12 md:-ml-12 lg:ml-0"
      >
        {
          product.data.blueprints.first && (
            <Image
              src={product.data.blueprints.first}
              class="absolute inset-0 size-full object-cover object-center"
              alt={`${previewAlt} 1`}
              format={'avif'}
            />
          )
        }
      </div>

      <div class="relative right-12 aspect-video w-3/5 overflow-hidden rounded-xl shadow-xl">
        {
          product.data.blueprints.second && (
            <Image
              src={product.data.blueprints.second}
              class="absolute inset-0 size-full object-cover object-center"
              alt={`${previewAlt} 2`}
              format={'avif'}
            />
          )
        }
      </div>
    </div>
    )}
  </div>

  {
    hasPaviiDownloads && (
      <div id="tabs-with-card-4" class="hidden" role="tabpanel">
        <DownloadAlternatives />
      </div>
    )
  }

  {
    hasPaviiDownloads && (
      <Fragment set:html={`<script>${paviiDownloadAnalyticsScript}</script>`} />
    )
  }
</MainLayout>

<script>
  // Put the visitor's OS first and mark it. Without JS the list keeps its
  // default order (Windows, macOS, Linux x64, Linux ARM64).
  const ua = navigator.userAgent;
  const os = /Android/i.test(ua) ? '' : /Win/i.test(ua) ? 'windows' : /Mac/i.test(ua) && !/iPhone|iPad/i.test(ua) ? 'macos' : /Linux|X11/i.test(ua) ? 'linux' : '';
  const isArm = /aarch64|arm64/i.test(ua);
  const links = [...document.querySelectorAll<HTMLElement>('[data-pavii-os]')];
  const match = links.filter(l => l.dataset.paviiOs === os);
  const pick = match.find(l => (l.dataset.architecture === 'aarch64') === isArm) ?? match[0];
  if (pick) {
    pick.setAttribute('data-recommended', '');
    pick.style.order = '-1';
  }
  document.querySelectorAll<HTMLElement>('[data-pavii-open-install]').forEach(a => {
    a.addEventListener('click', () => {
      document.querySelector<HTMLElement>('[data-target="#tabs-with-card-4"]')?.click();
    });
  });
</script>

<script>
  // Live release version: the displayed number follows the newest GitHub
  // release automatically, so publishing a release updates the site with no
  // deploy. The build-time version stays as the no-JS / rate-limit fallback,
  // and a short sessionStorage cache keeps us far under GitHub's
  // unauthenticated API limits.
  const versionEl = document.querySelector<HTMLElement>('[data-pavii-card-title]');
  const releaseApi = versionEl?.dataset.releaseApi;
  const staticVersion = versionEl?.dataset.staticVersion;
  if (versionEl && releaseApi && staticVersion) {
    const cacheKey = `pavii-latest-version:${releaseApi}`;
    const applyVersion = (version: string) => {
      if (!version || version === staticVersion) return;
      versionEl.textContent = (versionEl.textContent ?? '').replace(staticVersion, version);
      document.querySelectorAll<HTMLElement>('[data-pavii-download][data-version]').forEach(el => {
        el.dataset.version = version;
      });
    };
    let cached: string | null = null;
    try {
      cached = sessionStorage.getItem(cacheKey);
    } catch {
      cached = null;
    }
    if (cached) {
      applyVersion(cached);
    } else {
      fetch(releaseApi, { headers: { Accept: 'application/vnd.github+json' } })
        .then(res => (res.ok ? res.json() : null))
        .then((release: { tag_name?: string } | null) => {
          const version = release?.tag_name?.replace(/^v/, '') ?? '';
          if (!version) return;
          try {
            sessionStorage.setItem(cacheKey, version);
          } catch {
            /* private mode: fine, we just fetch again next page view */
          }
          applyVersion(version);
        })
        .catch(() => {
          /* offline or rate-limited: the static fallback stays */
        });
    }
  }
</script>

<script>
  import { gsap } from 'gsap';

  type AnimationSettings = {
    autoAlpha?: number;
    y?: number;
    x?: number;
    willChange?: string;
  };

  function setElementAnimationDefaults(
    id: string,
    settings: AnimationSettings
  ) {
    gsap.set(id, settings);
  }

  setElementAnimationDefaults('#fadeText', {
    autoAlpha: 0,
    y: 50,
    willChange: 'transform, opacity',
  });

  setElementAnimationDefaults('#fadeInUp', {
    autoAlpha: 0,
    y: 50,
    willChange: 'transform, opacity',
  });

  setElementAnimationDefaults('#fadeInMoveRight', {
    autoAlpha: 0,
    x: 300,
    willChange: 'transform, opacity',
  });

  let timeline = gsap.timeline({ defaults: { overwrite: 'auto' } });

  timeline.to('#fadeText', {
    duration: 1.5,
    autoAlpha: 1,
    y: 0,
    delay: 1,
    ease: 'power2.out',
  });

  timeline.to(
    '#fadeInUp',
    { duration: 1.5, autoAlpha: 1, y: 0, ease: 'power2.out' },
    '-=1.2'
  );

  timeline.to(
    '#fadeInMoveRight',
    { duration: 1.5, autoAlpha: 1, x: 0, ease: 'power2.inOut' },
    '-=1.4'
  );

  timeline.to('#overlay', { duration: 1, autoAlpha: 0, delay: 0.2 });
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll<HTMLButtonElement>(
      '[data-copy-command]'
    );

    copyButtons.forEach(copyButton => {
      const statusId = copyButton.getAttribute('aria-describedby');
      const status = statusId
        ? document.querySelector<HTMLElement>(`#${statusId}`)
        : null;
      const label = copyButton.querySelector<HTMLElement>('[data-copy-label]');

      if (!status || !label) return;

      copyButton.addEventListener('click', async () => {
        const text = copyButton.dataset.copyText;
        const successMessage =
          copyButton.dataset.copySuccess ?? 'Command copied.';
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          label.textContent = 'Copied';
          status.textContent = successMessage;
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand('copy');
          textarea.remove();
          label.textContent = copied ? 'Copied' : 'Copy failed';
          status.textContent = copied
            ? successMessage
            : 'Select the command manually and copy it.';
        }

        window.setTimeout(() => {
          label.textContent = 'Copy command';
        }, 2500);
      });
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    function setButtonInactive(btn: any, activeButton: any) {
      if (btn !== activeButton) {
        btn.classList.remove(
          'active',
          'bg-neutral-100',
          'hover:border-transparent',
          'dark:bg-white/[.05]'
        );

        const tabId = btn.getAttribute('data-target');
        if (tabId) {
          const contentElement = document.querySelector(tabId);
          if (contentElement) {
            contentElement.classList.add('hidden');
          }
        }

        changeHeadingStyle(
          btn,
          ['text-neutral-800', 'dark:text-neutral-200'],
          ['text-blue-400', 'dark:text-blue-300']
        );
      }
    }

    function activateButton(button: any) {
      button.classList.add(
        'active',
        'bg-neutral-100',
        ',hover:border-transparent',
        'dark:bg-white/[.05]'
      );

      const tabId = button.getAttribute('data-target');
      if (tabId) {
        const contentElementToShow = document.querySelector(tabId);
        if (contentElementToShow) {
          contentElementToShow.classList.remove('hidden');
        }
      }

      changeHeadingStyle(
        button,
        ['text-blue-400', 'dark:text-blue-300'],
        ['text-neutral-800', 'dark:text-neutral-200']
      );
    }

    function changeHeadingStyle(
      button: any,
      addClasses: any,
      removeClasses: any
    ) {
      let heading = button.querySelector('span');
      if (heading) {
        heading.classList.remove(...removeClasses);
        heading.classList.add(...addClasses);
      }
    }

    const tabButtons = document.querySelectorAll('[data-target]');

    if (tabButtons.length > 0) {
      changeHeadingStyle(
        tabButtons[0],
        ['text-blue-400', 'dark:text-blue-300'],
        []
      );
    }

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        tabButtons.forEach(btn => setButtonInactive(btn, button));
        activateButton(button);
      });
    });
  });
</script>
