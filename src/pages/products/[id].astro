---
// Import section components
import MainLayout from '@/layouts/MainLayout.astro';
import DownloadAlternatives from '@components/products/DownloadAlternatives.astro';
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE, SOCIAL_PREVIEW_IMAGE_URL } from '@data/constants';

// Global declaration for gsap animation library
declare global {
  interface Window {
    gsap: any;
  }
}

// This gets the static paths for all the unique products

export async function getStaticPaths() {
  const productEntries = await getCollection('products', ({ id }) =>
    id.startsWith('en/')
  );
  return productEntries.map(product => {
    const idWithoutLang = product.id.replace(/^en\//, ''); // Remove the "en/" prefix
    return {
      params: { id: idWithoutLang },
      props: { product },
    };
  });
}

const { product } = Astro.props;

const pageTitle: string = `${product.data.title} | ${SITE.title}`;
const metaDescription = product.data.description;
const ogTitle = `${product.data.title} | AI Infrastructure Product | ${SITE.title}`;
const isDevTools = product.data.title === 'Dev Tools';
const isSuperAssistant = product.data.title === 'Super Assistant';
const hasPaviiDownloads = isDevTools || isSuperAssistant;
const devToolsReleaseVersion = '2.2.0';
const devToolsReleaseRepo = 'https://github.com/buckleson/Pavii-Gui-Releases';
const devToolsLatestDownload = `${devToolsReleaseRepo}/releases/latest/download`;
const superAssistantReleaseVersion = '2.0.5';
const superAssistantReleaseRepo = 'https://github.com/vjk7989/pavii-release';
const superAssistantLatestDownload = `${superAssistantReleaseRepo}/releases/latest/download`;
const paviiReleaseVersion = isDevTools
  ? devToolsReleaseVersion
  : superAssistantReleaseVersion;
// The live-version script asks GitHub for the actual latest release so the
// page never goes stale between site deploys; the static version above is
// the no-JS/rate-limited fallback. Download links already use
// releases/latest/download/... stable names, so only the label needs this.
const paviiReleaseApi = isDevTools
  ? 'https://api.github.com/repos/buckleson/Pavii-Gui-Releases/releases/latest'
  : 'https://api.github.com/repos/vjk7989/pavii-release/releases/latest';
const paviiCardTitle = isDevTools
  ? `Download Pavii.Ai ${paviiReleaseVersion}`
  : `Download and try PAVii ${paviiReleaseVersion}`;
const paviiCardDescription = isDevTools
  ? 'Install the latest Pavii.Ai desktop build from the official mirror release repo.'
  : 'Click below to download PAVii 2.0.5 and try our latest model-agnostic agentic solution.';
const paviiCardNote = isDevTools
  ? 'Pick the installer that matches your operating system and CPU architecture. In-app updates continue to use the main updater feed.'
  : 'Future updates download automatically in the background. PAVii asks before relaunching into the new version.';
const paviiDownloads = isDevTools
  ? [
      {
        os: 'Windows',
        label: 'Windows x64',
        architecture: 'x64',
        packageType: 'nsis',
        url: `${devToolsLatestDownload}/Pavii.Ai-Windows-x64-Setup.exe`,
      },
      {
        os: 'Windows',
        label: 'Windows ARM64',
        architecture: 'arm64',
        packageType: 'nsis',
        url: `${devToolsLatestDownload}/Pavii.Ai-Windows-arm64-Setup.exe`,
      },
      {
        os: 'macOS',
        label: 'macOS Apple Silicon',
        architecture: 'arm64',
        packageType: 'dmg',
        url: `${devToolsLatestDownload}/Pavii.Ai-macOS-arm64.dmg`,
      },
      {
        os: 'macOS',
        label: 'macOS Intel',
        architecture: 'x64',
        packageType: 'dmg',
        url: `${devToolsLatestDownload}/Pavii.Ai-macOS-x64.dmg`,
      },
      {
        os: 'Linux',
        label: 'Linux x64',
        architecture: 'x64',
        packageType: 'appimage',
        url: `${devToolsLatestDownload}/Pavii.Ai-Linux-x64.AppImage`,
      },
      {
        os: 'Linux',
        label: 'Linux ARM64',
        architecture: 'arm64',
        packageType: 'appimage',
        url: `${devToolsLatestDownload}/Pavii.Ai-Linux-arm64.AppImage`,
      },
    ]
  : [
      {
        os: 'Windows',
        label: 'Windows x64',
        architecture: 'x64',
        packageType: 'nsis',
        url: `${superAssistantLatestDownload}/PAVii-Windows-x64-setup.exe`,
      },
      {
        os: 'macOS',
        label: 'macOS · Apple Silicon',
        architecture: 'arm64',
        packageType: 'dmg',
        url: `${superAssistantLatestDownload}/PAVii-macOS-arm64.dmg`,
      },
      {
        os: 'Linux',
        label: 'Linux x64',
        architecture: 'x64',
        packageType: 'appimage',
        url: `${superAssistantLatestDownload}/PAVii-Linux-x64.AppImage`,
      },
    ];
const paviiSecondaryDownloads = isDevTools
  ? [
      {
        label: 'Checksums',
        os: '',
        architecture: '',
        packageType: '',
        url: `${devToolsLatestDownload}/SHA256SUMS`,
      },
      {
        label: 'All releases',
        os: '',
        architecture: '',
        packageType: '',
        url: `${devToolsReleaseRepo}/releases/latest`,
      },
    ]
  : [
      {
        label: 'Windows MSI',
        os: 'Windows',
        architecture: 'x64',
        packageType: 'msi',
        url: `${superAssistantLatestDownload}/PAVii-Windows-x64.msi`,
      },
      {
        label: 'Linux DEB',
        os: 'Linux',
        architecture: 'x64',
        packageType: 'deb',
        url: `${superAssistantLatestDownload}/PAVii-Linux-x64.deb`,
      },
      {
        label: 'Linux RPM',
        os: 'Linux',
        architecture: 'x64',
        packageType: 'rpm',
        url: `${superAssistantLatestDownload}/PAVii-Linux-x64.rpm`,
      },
      {
        label: 'Checksums',
        os: '',
        architecture: '',
        packageType: '',
        url: `${superAssistantLatestDownload}/SHA256SUMS`,
      },
      {
        label: 'All releases',
        os: '',
        architecture: '',
        packageType: '',
        url: `${superAssistantReleaseRepo}/releases/latest`,
      },
    ];
const paviiDownloadGroups = [
  {
    os: 'Windows',
    key: 'windows',
    items: [
      {
        label: 'Windows x64 Setup',
        architecture: 'x64',
        packageType: 'nsis',
        url: `${devToolsLatestDownload}/Pavii.Ai-Windows-x64-Setup.exe`,
      },
      {
        label: 'Windows ARM64 Setup',
        architecture: 'arm64',
        packageType: 'nsis',
        url: `${devToolsLatestDownload}/Pavii.Ai-Windows-arm64-Setup.exe`,
      },
    ],
  },
  {
    os: 'macOS',
    key: 'macos',
    items: [
      {
        label: 'Apple Silicon DMG',
        architecture: 'arm64',
        packageType: 'dmg',
        url: `${devToolsLatestDownload}/Pavii.Ai-macOS-arm64.dmg`,
      },
      {
        label: 'Intel DMG',
        architecture: 'x64',
        packageType: 'dmg',
        url: `${devToolsLatestDownload}/Pavii.Ai-macOS-x64.dmg`,
      },
    ],
  },
  {
    os: 'Linux',
    key: 'linux',
    items: [
      {
        label: 'x64 AppImage',
        architecture: 'x64',
        packageType: 'appimage',
        url: `${devToolsLatestDownload}/Pavii.Ai-Linux-x64.AppImage`,
      },
      {
        label: 'ARM64 AppImage',
        architecture: 'arm64',
        packageType: 'appimage',
        url: `${devToolsLatestDownload}/Pavii.Ai-Linux-arm64.AppImage`,
      },
      {
        label: 'x64 DEB',
        architecture: 'x64',
        packageType: 'deb',
        url: `${devToolsLatestDownload}/Pavii.Ai-Linux-x64.deb`,
      },
      {
        label: 'ARM64 DEB',
        architecture: 'arm64',
        packageType: 'deb',
        url: `${devToolsLatestDownload}/Pavii.Ai-Linux-arm64.deb`,
      },
    ],
  },
];
// Downloads the build matching the Mac it runs on, replaces any installed copy,
// clears the quarantine flag and ad-hoc signs the app so an un-notarized build
// stops being reported as damaged. Idempotent, so it is also the update path.
// The URL is the version-agnostic `releases/latest/download` base, same as every
// other link on this page. Contains no `${`, so nothing here is interpolated by
// the template literal.
const devToolsMacosInstallCommand = `ARCH=$([ "$(uname -m)" = "arm64" ] && echo arm64 || echo x64) && curl -fL -o ~/Downloads/Pavii.dmg "${devToolsLatestDownload}/Pavii.Ai-macOS-$ARCH.dmg" && osascript -e 'quit app "Pavii.Ai"' 2>/dev/null; VOL=$(hdiutil attach -nobrowse ~/Downloads/Pavii.dmg | grep -o '/Volumes/.*') && rm -rf /Applications/Pavii.Ai.app && cp -R "$VOL"/*.app /Applications/ && hdiutil detach "$VOL" && xattr -dr com.apple.quarantine /Applications/Pavii.Ai.app && codesign --force --deep --sign - /Applications/Pavii.Ai.app && open /Applications/Pavii.Ai.app`;

const downloadAlternativesProps = isDevTools
  ? {
      macosInstallCommand: devToolsMacosInstallCommand,
      windowsInstallerName: 'Pavii.Ai-Windows-x64-Setup.exe',
      windowsInstallerUrl: `${devToolsLatestDownload}/Pavii.Ai-Windows-x64-Setup.exe`,
      windowsRepositoryLabel: 'PAVii mirror release repository',
    }
  : {};
const devToolsDownloadPickerScript = `
(() => {
  const picker = document.querySelector('[data-pavii-os-picker]');
  if (!picker) return;

  const activeButtonClasses = [
    'border-blue-500',
    'bg-blue-500',
    'text-white',
    'hover:bg-blue-600',
  ];
  const inactiveButtonClasses = [
    'border-neutral-200',
    'bg-white',
    'text-neutral-800',
    'hover:border-blue-300',
    'hover:text-blue-700',
    'dark:border-neutral-700',
    'dark:bg-neutral-900',
    'dark:text-neutral-200',
    'dark:hover:border-blue-500',
    'dark:hover:text-blue-300',
  ];
  const inactiveIconClasses = ['text-blue-600', 'dark:text-blue-400'];
  const triggers = picker.querySelectorAll('[data-pavii-os-trigger]');
  const panels = picker.querySelectorAll('[data-pavii-os-panel]');

  const selectOs = key => {
    triggers.forEach(trigger => {
      const isActive = trigger.dataset.paviiOsTrigger === key;
      const icon = trigger.querySelector('[data-pavii-os-icon]');
      trigger.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      trigger.classList.remove(
        ...(isActive ? inactiveButtonClasses : activeButtonClasses)
      );
      trigger.classList.add(
        ...(isActive ? activeButtonClasses : inactiveButtonClasses)
      );

      if (isActive) {
        trigger.setAttribute('style', 'background-color:#3b82f6; color:#ffffff;');
        icon?.classList.remove(...inactiveIconClasses);
        icon?.classList.add('text-white');
      } else {
        trigger.removeAttribute('style');
        icon?.classList.remove('text-white');
        icon?.classList.add(...inactiveIconClasses);
      }
    });

    panels.forEach(panel => {
      panel.classList.toggle('hidden', panel.dataset.paviiOsPanel !== key);
    });
  };

  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      selectOs(trigger.dataset.paviiOsTrigger);
    });
  });
})();
`;
const paviiDownloadAnalyticsScript = `
(() => {
  const endpoint = 'https://eu.i.posthog.com/capture/';
  const apiKey = 'phc_yimrxw6UXv4iezUNR7MfzG3rXNPww9psTM757SACa7qg';
  document.querySelectorAll('[data-pavii-download]').forEach(link => {
    link.addEventListener('click', () => {
      const element = link;
      const payload = {
        api_key: apiKey,
        event: 'pavii_download',
        properties: {
          distinct_id: crypto.randomUUID(),
          $process_person_profile: false,
          platform: element.dataset.platform,
          architecture: element.dataset.architecture,
          package_type: element.dataset.package,
          app_version: element.dataset.version,
          source: 'pavii_website',
          telemetry_schema: 1,
        },
      };
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      }).catch(() => {});
    });
  });
})();
`;
const previewAlt = `${product.data.title} ${product.data.tabs[2]?.title ?? 'preview'}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${SITE.url}/products/${product.id.replace(/^en\//, '')}`,
    url: `${SITE.url}/products/${product.id.replace(/^en\//, '')}`,
    name: product.data.title,
    description: product.data.description,
    image: SOCIAL_PREVIEW_IMAGE_URL,
    brand: {
      '@type': 'Brand',
      name: SITE.title,
    },
    category: 'AI infrastructure software',
    audience: {
      '@type': 'Audience',
      audienceType: 'developers, businesses, AI teams, enterprises',
    },
  }}
>
  <div id="overlay" class="fixed inset-0 bg-neutral-200 dark:bg-neutral-800">
  </div>

  <section
    class="mx-auto flex max-w-[85rem] flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div>
      <p
        id="fadeText"
        class="mb-8 max-w-prose font-light text-pretty text-neutral-700 sm:text-xl dark:text-neutral-300"
      >
        {product.data.main.content}
      </p>
    </div>
    <div class="flex flex-col items-center justify-between gap-8 lg:flex-row">
      <div id="fadeInUp" class="w-full min-w-0 flex-1">
        <h1
          class="block text-4xl font-bold tracking-tighter text-neutral-800 sm:text-5xl md:text-6xl lg:text-7xl dark:text-neutral-200"
        >
          {product.data.title}
        </h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-400">
          {product.data.description}
        </p>
        {
          hasPaviiDownloads && (
            <div class="mt-8 w-full max-w-3xl rounded-2xl border border-neutral-200 bg-white/80 p-4 shadow-sm backdrop-blur sm:p-6 dark:border-neutral-700 dark:bg-neutral-900/70">
              <p
                class="text-sm font-semibold tracking-wide text-neutral-800 uppercase dark:text-neutral-200"
                data-pavii-card-title
                data-static-version={paviiReleaseVersion}
                data-release-api={paviiReleaseApi}
              >
                {paviiCardTitle}
              </p>
              <p class="mt-2 text-base text-neutral-600 dark:text-neutral-400">
                {paviiCardDescription}
              </p>
              <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
                {paviiCardNote}
              </p>
              {isDevTools ? (
                <div class="mt-5" data-pavii-os-picker>
                  <div class="grid gap-3 sm:grid-cols-3">
                    {paviiDownloadGroups.map((group, index) => (
                      <button
                        type="button"
                        data-pavii-os-trigger={group.key}
                        aria-expanded={index === 0 ? 'true' : 'false'}
                        class={`group inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border px-4 py-3 text-sm font-bold shadow-sm transition duration-300 focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden 2xl:text-base dark:focus-visible:ring-blue-800 ${
                          index === 0
                            ? 'border-blue-500 bg-blue-500 text-white hover:bg-blue-600'
                            : 'border-neutral-200 bg-white text-neutral-800 hover:border-blue-300 hover:text-blue-700 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-blue-500 dark:hover:text-blue-300'
                        }`}
                        style={
                          index === 0
                            ? 'background-color:#3b82f6; color:#ffffff;'
                            : undefined
                        }
                      >
                        {group.os === 'Windows' && (
                          <svg
                            class={`size-5 shrink-0 ${index === 0 ? 'text-white' : 'text-blue-600 dark:text-blue-400'}`}
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            data-pavii-os-icon
                          >
                            <path
                              fill="currentColor"
                              d="M3 5.4 10.7 4v7.3H3V5.4Zm8.6-1.6L21 2.1v9.2h-9.4V3.8ZM3 12.7h7.7V20L3 18.6v-5.9Zm8.6 0H21v9.2l-9.4-1.7v-7.5Z"
                            />
                          </svg>
                        )}
                        {group.os === 'macOS' && (
                          <svg
                            class={`size-5 shrink-0 ${index === 0 ? 'text-white' : 'text-blue-600 dark:text-blue-400'}`}
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            data-pavii-os-icon
                          >
                            <path
                              fill="currentColor"
                              d="M16.4 13c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.1-1.7-1.3-.1-2.6.8-3.3.8s-1.8-.8-2.9-.8c-1.5 0-2.9.9-3.7 2.2-1.6 2.8-.4 6.9 1.1 9.1.8 1.1 1.7 2.3 2.9 2.3 1.1 0 1.6-.7 2.9-.7 1.4 0 1.8.7 3 .7 1.2 0 2-1.1 2.8-2.2.9-1.3 1.2-2.5 1.2-2.6 0-.1-2.8-1.1-2.8-3.7ZM14.4 6.5c.6-.8 1.1-1.9 1-3-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2-.5 2.7-1.3Z"
                            />
                          </svg>
                        )}
                        {group.os === 'Linux' && (
                          <svg
                            class={`size-5 shrink-0 ${index === 0 ? 'text-white' : 'text-blue-600 dark:text-blue-400'}`}
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            data-pavii-os-icon
                          >
                            <path
                              fill="currentColor"
                              d="M12 2c-2 0-3.5 1.8-3.5 4.1 0 1-.2 1.7-.7 2.5-.6 1-1.3 2.2-1.4 4.4L4.2 17.8c-.4.8 0 1.7.8 2.1.7.3 1.5.1 2-.5.8 1.6 2.7 2.6 5 2.6s4.2-1 5-2.6c.5.6 1.3.8 2 .5.8-.4 1.2-1.3.8-2.1L17.6 13c-.1-2.2-.8-3.4-1.4-4.4-.5-.8-.7-1.5-.7-2.5C15.5 3.8 14 2 12 2Zm-1.2 4.2c.4 0 .7.3.7.8s-.3.8-.7.8-.7-.3-.7-.8.3-.8.7-.8Zm2.4 0c.4 0 .7.3.7.8s-.3.8-.7.8-.7-.3-.7-.8.3-.8.7-.8ZM10 10h4c-.2 1-1 1.6-2 1.6S10.2 11 10 10Zm-1.5 5.1c.7.5 1.9.9 3.5.9s2.8-.4 3.5-.9c-.2 2.5-1.4 4.1-3.5 4.1s-3.3-1.6-3.5-4.1Z"
                            />
                          </svg>
                        )}
                        <span>{group.os}</span>
                      </button>
                    ))}
                  </div>
                  <div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 p-3 dark:border-blue-900/60 dark:bg-blue-950/20">
                    {paviiDownloadGroups.map((group, index) => (
                      <div
                        class={index === 0 ? '' : 'hidden'}
                        data-pavii-os-panel={group.key}
                      >
                        <p class="px-1 text-sm font-semibold text-neutral-900 dark:text-white">
                          Select {group.os} installer
                        </p>
                        <div class="mt-3 grid gap-2 sm:grid-cols-2">
                          {group.items.map(download => (
                            <a
                              href={download.url}
                              data-pavii-download
                              data-platform={group.key}
                              data-architecture={download.architecture}
                              data-package={download.packageType}
                              data-version={paviiReleaseVersion}
                              class="group inline-flex min-h-11 items-center justify-between gap-3 rounded-lg border border-neutral-200 bg-white px-4 py-2 text-sm font-semibold text-neutral-800 transition hover:border-blue-300 hover:text-blue-700 focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-blue-500 dark:hover:text-blue-300"
                            >
                              <span>{download.label}</span>
                              <svg
                                class="size-4 shrink-0 text-blue-600 transition duration-300 group-hover:translate-y-0.5 dark:text-blue-400"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <path d="M7 10l5 5 5-5" />
                                <path d="M12 15V3" />
                              </svg>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="mt-5 flex flex-wrap gap-3">
                  {paviiDownloads.map(download => (
                    <a
                      href={download.url}
                      data-pavii-download
                      data-platform={download.os.toLowerCase()}
                      data-architecture={download.architecture}
                      data-package={download.packageType}
                      data-version={paviiReleaseVersion}
                      class="group inline-flex min-w-44 items-center justify-center gap-2 rounded-lg bg-blue-500 px-5 py-3 text-sm font-bold text-white shadow-sm transition duration-300 hover:bg-blue-600 focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden active:bg-blue-700 2xl:text-base dark:focus-visible:ring-blue-800"
                      style="background-color:#3b82f6; color:#ffffff;"
                      aria-label={`Download PAVii for ${download.os}`}
                    >
                      <span>{download.label}</span>
                      <svg
                        class="size-4 shrink-0 text-white transition duration-300 group-hover:translate-x-1"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                    </a>
                  ))}
                </div>
              )}
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
                {paviiSecondaryDownloads.map(download => (
                  <a
                    href={download.url}
                    data-pavii-download={download.packageType ? '' : undefined}
                    data-platform={download.os.toLowerCase()}
                    data-architecture={download.architecture}
                    data-package={download.packageType}
                    data-version={paviiReleaseVersion}
                    class="font-medium text-blue-600 underline decoration-blue-300 underline-offset-4 transition hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
                  >
                    {download.label}
                  </a>
                ))}
              </div>
              <p class="mt-4 max-w-2xl text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
                PAVii counts package downloads by operating system, package
                type, and country. The event contains no account details or
                browsing activity.
              </p>
            </div>
          )
        }
      </div>
      <div class="w-full max-w-[600px] shrink-0">
        <Image
          id="fadeInMoveRight"
          src={product.data.main.imgMain}
          class="h-auto w-full"
          alt={product.data.main.imgAlt}
          format={'avif'}
          loading={'eager'}
        />
      </div>
