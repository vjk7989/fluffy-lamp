---
// Importing necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CardSmall from '@components/ui/cards/CardSmall.astro';
import CardWide from '@components/ui/cards/CardWide.astro';
import FeaturesStatsAlt from '@components/sections/features/FeaturesStatsAlt.astro';
import TestimonialsSectionAlt from '@components/sections/testimonials/TestimonialsSectionAlt.astro';

// Importing necessary functions from Astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE, SOCIAL_PREVIEW_IMAGE_URL } from '@data/constants';

// Fetching all the product related content and sorting it by main.id
const product: CollectionEntry<'products'>[] = (
  await getCollection('products', ({ id }) => {
    return id.startsWith('en/');
  })
).sort(
  (a: CollectionEntry<'products'>, b: CollectionEntry<'products'>) =>
    a.data.main.id - b.data.main.id
);

// Define variables for page content
const title: string = 'Products';
const subTitle: string =
  "Discover the power of PAVIi.AI's AI infrastructure platform, built to help businesses deploy, manage, and scale intelligent applications with ease. From AI agents and automation workflows to secure data management and enterprise integrations, PAVIi.AI provides the foundation for building next-generation AI solutions faster, smarter, and more efficiently.";

// Testimonial data that will be rendered in the component
const testimonials = [
  // First testimonial data
  {
    content:
      ' "PAVIi.AI helped us move from scattered experiments to production-ready AI workflows. The agent tool kit gave our teams a reliable way to build, test, and ship assistants across departments." ',
    author: 'Ritesh Patel.K',
    role: 'Operations Lead | TopBuild',
    avatarSrc:
      'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1374&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
    avatarAlt: 'Image Description',
  },
  // Second testimonial data
  {
    content:
      ' "The context and inference layer made our customer interactions feel consistent and informed. PAVIi.AI gave us the confidence to scale AI support without losing control of our data or brand voice." ',
    author: 'Sheryaa Anuradha',
    role: 'Customer Experience Director | Creative Spaces',
    avatarSrc:
      'https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=1376&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
    avatarAlt: 'Image Description',
  },
  // Third testimonial data
  {
    content:
      ' "Super Assistant changed how quickly our internal teams find answers, summarize work, and act on live business context. It feels less like a chatbot and more like an operating layer for daily decisions." ',
    author: 'NagRaj S',
    role: 'Product Manager | FirstWoods AI',
    avatarSrc:
      'https://images.unsplash.com/photo-1474176857210-7287d38d27c6?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
    avatarAlt: 'Image Description',
  },
];

const pageTitle: string = `Products | ${SITE.title}`;
const metaDescription =
  'Explore PAVIi.AI products for building AI agents, context-aware inference workflows, super assistant experiences, and developer-ready AI infrastructure.';
const ogTitle = 'AI Infrastructure Products | PAVIi.AI';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/products`,
    url: `${SITE.url}/products`,
    name: 'AI Infrastructure Products | PAVIi.AI',
    description:
      'Explore PAVIi.AI products for AI agents, inference workflows, super assistant experiences, and developer-ready AI infrastructure.',
    image: SOCIAL_PREVIEW_IMAGE_URL,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: 'PAVIi.AI',
      description:
        'PAVIi.AI helps teams deploy, manage, and scale intelligent applications with secure AI infrastructure.',
    },
    inLanguage: 'en-US',
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1
          class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
        >
          {title}
        </h1>
        {
          subTitle && (
            <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 md:block dark:text-neutral-400">
              {subTitle}
            </p>
          )
        }
      </div>
      <!-- <PrimaryCTA title="Customer Stories" url="#testimonials" noArrow={true} /> -->
       <PrimaryCTA title="Contact US" url="https://cal.com/buckleson-group/30min" noArrow={true} />
    </div>
    {
      /* Displaying products in alternating styles. Alternative product gets different card styling.
    Maps through all product entries and displays them with either CardSmall or CardWide based on their position. */
    }
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {
        product.map((product, index) => {
          const position = index % 4;
          if (position === 0 || position === 3) {
            return <CardSmall product={product} />;
          } else {
            return <CardWide product={product} />;
          }
        })
      }
    </section>
  </div>
  {/* Features statistics section */}
  <FeaturesStatsAlt
    title="Why Choose PAVIi.AI?"
    subTitle="Move from AI prototypes to dependable production systems with a platform built for agents, context, inference, and secure enterprise workflows. PAVIi.AI gives teams the tools to launch faster, automate smarter, and scale with confidence."
    benefits={[
      'Agent-ready infrastructure for building intelligent workflows faster.',
      'Context-aware inference designed for accurate, useful business outcomes.',
      'Developer tools and support built for secure, scalable AI deployment.',
    ]}
  />
  {/* Testimonials section */}
  <TestimonialsSectionAlt
    title="What Our Customers Say"
    testimonials={testimonials}
  />
</MainLayout>
