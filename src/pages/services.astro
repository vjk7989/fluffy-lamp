---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';

// Import necessary images
import aiWorkflow from '@images/service-ai-workflow.avif';
import aiTools from '@images/service-ai-code-assistant.avif';
import customSolution from '@images/service-ai-custom-solution.avif';
import inferenceDiagram from '@images/service-ai-inference-routing.avif';
import inferenceDashboard from '@images/service-ai-inference-hosting.avif';
import mcpSystems from '@images/service-ai-mcp-business.avif';
import npuModel from '@images/service-ai-npu-chip.avif';
import npuInfra from '@images/service-ai-model-efficiency.avif';
import physicalAi from '@images/service-ai-physical-ai.avif';
import { SITE, SOCIAL_PREVIEW_IMAGE_URL } from '@data/constants';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Agentic Security and Observability',
    subTitle:
      'We put your AI agents behind one Pavii gateway. Pavii checks every call at six gates: injection, privacy, supply chain, budget, egress and output. Your team sees each call, tool, blocked action and cost. Each receipt links to the one before it on Hyper 0X, so nobody can secretly change the record.',
    single: false,
    imgOne: aiWorkflow,
    imgOneAlt: 'Minimal dashboard for planning and monitoring AI work',
    imgTwo: aiTools,
    imgTwoAlt: 'Clean interface for AI tools and automation',
  },
  {
    isRightSection: false,
    title: 'Custom Agents and Developer Workflows',
    subTitle:
      'We build custom AI agents and fine-tuned models for your work. We shape the context, tools and agent logic around your real use case. Your developers get a full AI workflow with tests, evaluations and checks. Every agent that we build runs behind Pavii security.',
    img: customSolution,
    imgAlt: 'Interface for custom AI agents and fine-tuned models',
    btnExists: true,
    btnTitle: 'Learn More',
    btnURL: '#',
  },
  {
    isRightSection: true,
    title: 'Inference for Hosting and Managing Models',
    subTitle:
      'We host, manage and route your AI models. Model routing sends each task to the model that fits it best. This cuts compute waste and keeps answers good as your product grows. The same Pavii gates protect every model call.',
    single: false,
    imgOne: inferenceDiagram,
    imgOneAlt: 'Diagram of AI model routing and model management',
    imgTwo: inferenceDashboard,
    imgTwoAlt: 'Model hosting dashboard for inference operations',
  },
  {
    isRightSection: false,
    title: 'MCP for AI-Accessible Business Systems',
    subTitle:
      'We build MCP servers and other AI-facing interfaces for your business. MCP (Model Context Protocol) is a standard way for AI agents to use tools and data. Agents can then find and use your product, website or internal systems with fewer errors. Pavii controls what each agent can do.',
    img: mcpSystems,
    imgAlt:
      'AI-accessible business systems connected through protocol tooling',
  },
  {
    isRightSection: true,
    title: 'NPU Optimized Models for Your Devices',
    subTitle:
      'We prepare models for NPUs (Neural Processing Units, chips made for AI) and edge devices. We tune, compress and adapt each model to run well on your hardware. Private data can stay on your device or inside your own systems.',
    single: false,
    imgOne: npuModel,
    imgOneAlt: 'Optimized AI model package for NPU deployment',
    imgTwo: npuInfra,
    imgTwoAlt: 'Clean infrastructure visual for NPU optimized AI models',
    btnExists: true,
    btnTitle: 'Read more',
    btnURL: '#',
  },
  {
    isRightSection: false,
    title: 'Physical AI for Daily Activity',
    subTitle:
      'Physical AI connects models and agents to sensors, devices and real-world tasks. We help you build these systems for everyday work. Pavii keeps clear rules and a full record for each action that an agent takes.',
    img: physicalAi,
    imgAlt: 'Physical AI systems connecting software agents with real-world activity',
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  'PAVii.AI services: agentic security and observability on Hyper 0X, custom AI agents, inference hosting, MCP integration, NPU optimized models and Physical AI.';
const ogTitle = 'Agentic Security and AI Services | PAVii.AI';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/services`,
    url: `${SITE.url}/services`,
    name: 'Agentic Security and AI Services | PAVii.AI',
    description: metaDescription,
    image: SOCIAL_PREVIEW_IMAGE_URL,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: 'PAVii.AI',
      description:
        'PAVii.AI is a blockchain-based security and observability platform for AI agents and LLMs.',
    },
    inLanguage: 'en-US',
  }}
>
  {
    /* MainSection is the introductory section of the page, it also contains a CTA button */
  }
  <MainSection
    title="Security First, Then Every AI Service You Need"
    subTitle="PAVii.AI protects and monitors your AI agents first. We also build custom agents, host models, connect your systems through MCP, prepare models for NPUs and build Physical AI. Every service runs behind Pavii security."
    btnExists={true}
    btnTitle="Book a Call"
    btnURL="https://cal.com/buckleson-group/30min"
  />
  <section class="mx-auto max-w-(--breakpoint-xl) px-4 py-10 sm:px-6 lg:px-8 lg:py-14" aria-labelledby="own-chain-title">
    <p class="text-sm font-semibold tracking-wide text-blue-600 uppercase dark:text-blue-400">Your chain, your rules</p>
    <h2 id="own-chain-title" class="mt-2 max-w-3xl text-3xl font-bold text-balance text-neutral-800 md:text-4xl dark:text-neutral-200">Run Pavii on your own chain</h2>
    <p class="mt-3 max-w-2xl text-lg text-pretty text-neutral-600 dark:text-neutral-400">Each team or app gets its own L2 with its own gates, egress rules and access rules for company memory. Hyper 0X settles every L2 and keeps the final record. Your business logic does not change.</p>
    <div class="mt-8"><IsoFigure name="chain-rack" /></div>
  </section>
  {
    /* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */
  }
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="By the Numbers"
    subTitle="Real results from Pavii in use. These numbers come from our own measurements."
    mainStatTitle="6"
    mainStatSubTitle="security gates on every agent call: injection, privacy, supply chain, budget, egress and output"
    stats={[
      {
        stat: '100M+',
        description: 'AI tokens saved across 82K+ queries',
      },
      {
        stat: '30-60%',
        description: 'fewer tokens on one measured Claude Code task',
      },
      {
        stat: '1',
        description: 'gateway for every AI agent and model',
      },
    ]}
  />
</MainLayout>
