---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';

// Import necessary images
import aiWorkflow from '@images/service-ai-workflow.png';
import aiTools from '@images/service-ai-code-assistant.png';
import customSolution from '@images/service-ai-custom-solution.png';
import inferenceDiagram from '@images/service-ai-inference-routing.png';
import inferenceDashboard from '@images/service-ai-inference-hosting.png';
import mcpSystems from '@images/service-ai-mcp-business.png';
import npuModel from '@images/service-ai-npu-chip.png';
import npuInfra from '@images/service-ai-model-efficiency.png';
import physicalAi from '@images/service-ai-physical-ai.png';
import { SITE, SOCIAL_PREVIEW_IMAGE_URL } from '@data/constants';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Full AI Dev Workflow for Your Developers',
    subTitle:
      'Give your engineering team a complete AI development workflow from planning and prototyping to testing, evaluation, deployment, and monitoring. PAVIi.AI helps developers build faster with AI agents, code-side model assistance, automated checks, and practical tooling that fits into their daily workflow.',
    single: false,
    imgOne: aiWorkflow,
    imgOneAlt: 'Minimal AI development dashboard for workflow planning and monitoring.',
    imgTwo: aiTools,
    imgTwoAlt: 'Clean AI tooling interface for developer automation',
  },
  {
    isRightSection: false,
    title: 'Custom AI Solutions Fine-Tuned for Your Needs',
    subTitle:
      'We build custom AI solutions around your business needs, including fine-tuned models and AI agents designed for optimal token usage and maximum accuracy. Instead of forcing a generic assistant into every workflow, we shape the model behavior, context, tools, and agent logic around your real use case.',
    img: customSolution,
    imgAlt: 'Custom AI solution interface for fine-tuned agents and model workflows',
    btnExists: true,
    btnTitle: 'Learn More',
    btnURL: '#',
  },
  {
    isRightSection: true,
    title: 'Inference Solutions for Hosting and Managing Models',
    subTitle:
      'Host, manage, and route your AI models with an inference layer built for production. PAVIi.AI helps you choose the right model for each task, manage performance, reduce compute waste, and keep inference reliable as your product scales.',
    single: false,
    imgOne: inferenceDiagram,
    imgOneAlt: 'Diagram of AI inference routing and model management infrastructure',
    imgTwo: inferenceDashboard,
    imgTwoAlt: 'Model hosting dashboard for inference operations',
  },
  {
    isRightSection: false,
    title: 'MCP for AI-Accessible Business Systems',
    subTitle:
      'We build MCP and AI-facing interfaces for your business so AI can understand and access your product, tools, website, or internal systems. This makes your business easier for AI agents to discover, reason about, and use with fewer errors.',
    img: mcpSystems,
    imgAlt:
      'AI-accessible business systems connected through protocol tooling',
  },
  {
    isRightSection: true,
    title: 'NPU Optimized Models for Your Needs',
    subTitle:
      'Deploy models optimized for Neural Processing Units and edge AI environments. We help tune, compress, route, and adapt models so they can run efficiently on the hardware that fits your product, device, or private infrastructure.',
    single: false,
    imgOne: npuModel,
    imgOneAlt: 'Optimized AI model package for NPU deployment',
    imgTwo: npuInfra,
    imgTwoAlt: 'Clean infrastructure visual for NPU optimized AI models',
    btnExists: true,
    btnTitle: 'Read more',
    btnURL: '#',
  },
  {
    isRightSection: false,
    title: 'Physical AI Solutions for Daily Activity',
    subTitle:
      'Build Physical AI systems that combine digital intelligence with real-world interaction. PAVIi.AI helps create solutions that connect models, agents, sensors, devices, and workflows so AI can become part of everyday activity in practical, useful ways.',
    img: physicalAi,
    imgAlt: 'Physical AI systems connecting software agents with real-world activity',
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  'PAVIi.AI provides AI development workflows, custom AI agents, inference hosting, MCP integration, NPU optimized models, and Physical AI solutions for modern businesses.';
const ogTitle = 'AI Infrastructure and Development Services | PAVIi.AI';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/services`,
    url: `${SITE.url}/services`,
    name: 'AI Infrastructure and Development Services | PAVIi.AI',
    description: metaDescription,
    image: SOCIAL_PREVIEW_IMAGE_URL,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: 'PAVIi.AI',
      description:
        'PAVIi.AI provides infrastructure, tools, and services for building, deploying, and scaling AI systems.',
    },
    inLanguage: 'en-US',
  }}
>
  {
    /* MainSection is the introductory section of the page, it also contains a CTA button */
  }
  <MainSection
    title="AI Services Built Around Your Business"
    subTitle="PAVIi.AI helps teams design, build, host, and optimize AI systems across the full lifecycle. From developer workflows and custom agents to inference, MCP integrations, NPU optimization, and Physical AI, our services are shaped around practical business outcomes."
    btnExists={true}
    btnTitle="Schedule a Consultation"
    btnURL="https://cal.com/buckleson-group/30min"
  />
  {
    /* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */
  }
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="By the Numbers"
    subTitle="PAVIi.AI services are designed to reduce AI build time, improve model accuracy, optimize token and compute usage, and make business systems easier for AI to access."
    mainStatTitle="6"
    mainStatSubTitle="core AI service areas covering development, agents, inference, MCP, NPU optimization, and Physical AI"
    stats={[
      {
        stat: '24/7',
        description: 'model hosting and inference support paths',
      },
      {
        stat: '100%',
        description: 'solutions shaped around your business context',
      },
      {
        stat: '1',
        description: 'partner for the full AI development lifecycle',
      },
    ]}
  />
</MainLayout>
