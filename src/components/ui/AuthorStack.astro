---
import { authorsOf, authorNames, initials, type AuthorId } from '@data/authors';

/** Overlapping author avatars with their names, for bylines and cards. */
interface Props {
  ids?: AuthorId[];
  size?: number;
  /** Text and ring colours for a dark card. */
  onDark?: boolean;
  class?: string;
}
const { ids, size = 40, onDark = false, class: className } = Astro.props;
const list = authorsOf(ids);
---

<span class:list={['flex items-center', className]}>
  <span class="flex shrink-0 -space-x-2.5" aria-hidden="true">
    {list.map(a => a.image
      ? <img src={a.image} alt="" width={size} height={size} loading="lazy" decoding="async" class:list={['rounded-full object-cover ring-2', onDark ? 'ring-white/40' : 'ring-white dark:ring-neutral-900']} style={`width:${size}px;height:${size}px`} />
      : <span class:list={['grid place-items-center rounded-full font-semibold ring-2', onDark ? 'bg-white/20 text-white ring-white/40' : 'bg-neutral-200 text-neutral-700 ring-white dark:bg-neutral-700 dark:text-neutral-100 dark:ring-neutral-900']} style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px`}>{initials(a.name)}</span>)}
  </span>
  <span class="ms-3 min-w-0"><slot name="before" /><span class:list={['block font-semibold', onDark ? 'text-white' : 'text-neutral-800 dark:text-neutral-200']} title={list.map(a => (a.role ? `${a.name}, ${a.role}` : a.name)).join(' · ')}>{authorNames(list)}</span><slot /></span>
</span>
