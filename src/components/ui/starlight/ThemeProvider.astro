{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
  window.StarlightThemeProvider = (() => {
    // The marketing pages store their choice under Preline's `hs_theme` key
    // and express it as a `.dark` class; Starlight uses `starlight-theme` and
    // a `data-theme` attribute. Without a bridge, switching to dark on the
    // site and clicking into the docs landed you back in light.
    const hasStorage = typeof localStorage !== 'undefined';
    const storedTheme = hasStorage && localStorage.getItem('starlight-theme');
    const marketingTheme = hasStorage && localStorage.getItem('hs_theme');
    const theme =
      storedTheme === 'dark' || (!storedTheme && marketingTheme === 'dark')
        ? 'dark'
        : 'light';
    document.documentElement.dataset.theme = theme;
    // Keep the class in sync too: Tailwind utilities inside docs pages are
    // compiled against the `.dark` variant, not `data-theme`.
    document.documentElement.classList.toggle('dark', theme === 'dark');
    return {
      updatePickers(theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light') {
        document.querySelectorAll('starlight-theme-select').forEach(picker => {
          const select = picker.querySelector('select');
          if (select) select.value = theme;
          /** @type {HTMLTemplateElement | null} */
          const tmpl = document.querySelector(`#theme-icons`);
          const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
          if (newIcon) {
            const oldIcon = picker.querySelector('svg.label-icon');
            if (oldIcon) {
              oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
            }
          }
        });
      },
    };
  })();
</script>

<template id="theme-icons">
  <svg class="light" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="4"></circle>
  </svg>
  <svg class="dark" viewBox="0 0 24 24">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg class="auto" viewBox="0 0 24 24">
    <path d="M12 18h.01"></path>
  </svg>
</template>
