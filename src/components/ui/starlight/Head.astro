---
import type { Props } from '@astrojs/starlight/props';
import StarlightHead from '@astrojs/starlight/components/Head.astro';
---

{/*
  View transitions were removed from the docs deliberately.

  astro-vtbot wrapped this head with a ClientRouter, which made docs -> docs
  navigation a PARTIAL swap: only `div.main-frame` (and the sidebar when its
  link list changed) was replaced, while the header, the page frame and the
  <html> attributes carried over from the previous page. Starlight's layout is
  driven entirely by those root attributes, so moving between the splash page
  (no sidebar, data-has-hero) and a body page (data-has-sidebar, data-has-toc)
  applied the frame state only partly — the sidebar sat off the left edge and
  the header floated detached until a refresh rebuilt the page.

  The same swap also stripped runtime <html> classes: Astro's swapRootAttributes
  clears every attribute and only `data-theme` was restored, so the `dark` class
  the ThemeProvider sets, and Lenis's own classes, were destroyed on every
  navigation.

  A 21-page docs site gains little from SPA navigation, and a full load rebuilds
  the frame correctly every time. The trade is losing sidebar scroll position
  between pages.
*/}

<StarlightHead {...Astro.props}><slot /></StarlightHead>
<script>
  const initSmoothScroll = async () => {
    await import('@scripts/lenisSmoothScroll.js');
  };
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void initSmoothScroll(), { timeout: 1000 });
  } else {
    setTimeout(() => void initSmoothScroll(), 100);
  }
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Lenis hijacks wheel events for the whole document, so any element with
    // its own scrollbar has to opt out explicitly or it simply will not
    // scroll. The sidebar overflows on any page with more than a screenful of
    // nav, and the mobile table-of-contents has the same problem.
    const scrollables = [
      'site-search',
      '.sidebar-pane',
      'mobile-starlight-toc nav',
      '.right-sidebar',
    ];
    for (const selector of scrollables) {
      document.querySelectorAll(selector).forEach(el => {
        el.setAttribute('data-lenis-prevent', '');
      });
    }
  });
</script>
