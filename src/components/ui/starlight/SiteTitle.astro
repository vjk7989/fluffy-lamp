---
import docsLogo from '@images/starlight/docs_logo.svg?raw';
import { withBase } from '@utils/urls';

// Docs are English-only and live under the Dev Tools product, so the old
// per-locale `/welcome-to-docs/` link logic is gone with the locales.
const main = withBase('/');
const docs = withBase('/products/dev-tools/docs/');
---

<span class="site-title flex">
  <a class="main-logo" href={main} data-astro-reload aria-label="PAVii.AI">
    <img src="/pavii-mark.png" alt="" width="28" height="28" loading="eager" />
    <span class="brand-text">PAVii.AI</span>
  </a>
  <a
    class="docs-logo"
    href={docs}
    set:html={docsLogo}
    aria-label="PAVii.AI Docs"
  />
</span>

<style>
  .site-title {
    gap: 1rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: flex;
  }

  .flex {
    display: flex;
    align-items: center;
  }
  .main-logo {
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .main-logo img {
    width: 1.75rem;
    height: 1.75rem;
  }
  .brand-text {
    font-weight: 700;
    color: var(--sl-color-white);
    white-space: nowrap;
  }
  .site-title a:focus-visible {
    outline: 0;
  }
  .site-title a:focus-visible > :global(*) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  .site-title :global(svg) {
    width: auto;
    height: auto;
  }
  .site-title a:hover :global(svg) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }
</style>
