---
type Props = {
  macosInstallCommand?: string;
  windowsInstallerName?: string;
  windowsInstallerUrl?: string;
  windowsRepositoryLabel?: string;
};

// One command that downloads the right architecture, replaces any existing
// copy, clears the quarantine flag and ad-hoc signs the app. The signing step
// is what stops macOS calling an un-notarized build "damaged"; it is harmless
// to repeat, so the same command doubles as the update path.
//
// Note for editors: this is a JS template literal, but the shell syntax below
// is safe to paste verbatim because it contains no `${` sequence -- `$ARCH`,
// `$(uname -m)` and `"$VOL"` are all left untouched by the interpolator.
const defaultMacosInstallCommand = `ARCH=$([ "$(uname -m)" = "arm64" ] && echo arm64 || echo x64) && curl -fL -o ~/Downloads/PAVii.dmg "https://github.com/vjk7989/pavii-release/releases/latest/download/PAVii-macOS-$ARCH.dmg" && osascript -e 'quit app "PAVii"' 2>/dev/null; VOL=$(hdiutil attach -nobrowse ~/Downloads/PAVii.dmg | grep -o '/Volumes/.*') && rm -rf /Applications/PAVii.app && cp -R "$VOL"/*.app /Applications/ && hdiutil detach "$VOL" && xattr -dr com.apple.quarantine /Applications/PAVii.app && codesign --force --deep --sign - /Applications/PAVii.app && open /Applications/PAVii.app`;

const {
  macosInstallCommand = defaultMacosInstallCommand,
  windowsInstallerName = 'PAVii-Windows-x64-setup.exe',
  windowsInstallerUrl = 'https://github.com/vjk7989/pavii-release/releases/latest/download/PAVii-Windows-x64-setup.exe',
  windowsRepositoryLabel = 'PAVii release repository',
} = Astro.props;

const windowsInstallCommands = [
  {
    label: 'PowerShell',
    description: 'Download with Invoke-WebRequest and open the installer.',
    command: `$installer = "$env:TEMP\\${windowsInstallerName}"
Invoke-WebRequest "${windowsInstallerUrl}" -OutFile $installer
Start-Process $installer`,
    statusId: 'windows-powershell-copy-status',
  },
  {
    label: 'curl.exe',
    description: 'Use the curl command included with current Windows versions.',
    command: `curl.exe -L "${windowsInstallerUrl}" -o "$env:TEMP\\${windowsInstallerName}"
& "$env:TEMP\\${windowsInstallerName}"`,
    statusId: 'windows-curl-copy-status',
  },
];
---

<div class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <section aria-labelledby="windows-alternatives-title">
      <div class="flex items-center gap-3">
        <svg
          class="size-6 shrink-0 text-blue-600 dark:text-blue-400"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M3 5.4 10.7 4v7.3H3V5.4Zm8.6-1.6L21 2.1v9.2h-9.4V3.8ZM3 12.7h7.7V20L3 18.6v-5.9Zm8.6 0H21v9.2l-9.4-1.7v-7.5Z"
          ></path>
        </svg>
        <h2
          id="windows-alternatives-title"
          class="text-2xl font-bold text-neutral-900 dark:text-white"
        >
          Browser download blocked?
        </h2>
      </div>
      <p class="mt-3 max-w-prose text-neutral-600 dark:text-neutral-300">
        Open PowerShell, copy either command, and press Enter. Both commands
        always download the latest Windows x64 release from the {
          windowsRepositoryLabel
        }.
      </p>

      <div class="mt-7 space-y-8">
        {
          windowsInstallCommands.map(item => (
            <div>
              <h3 class="font-semibold text-neutral-900 dark:text-white">
                {item.label}
              </h3>
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                {item.description}
              </p>
              <pre class="mt-3 min-w-0 overflow-x-auto rounded-xl bg-neutral-950 px-4 py-4 text-xs leading-5 text-white">
                <code>{item.command}</code>
              </pre>
              <div class="mt-3 flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white transition duration-200 hover:bg-blue-700 focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden active:bg-blue-800 dark:focus-visible:ring-blue-800"
                  style="background-color:#2563eb; color:#ffffff;"
                  data-copy-command
                  data-copy-text={item.command}
                  data-copy-success="Command copied. Paste it into PowerShell and press Enter."
                  aria-label={`Copy ${item.label} command`}
                  aria-describedby={item.statusId}
                >
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                  </svg>
                  <span data-copy-label>Copy command</span>
                </button>
                <p
                  id={item.statusId}
                  class="min-h-5 text-sm text-blue-800 dark:text-blue-200"
                  aria-live="polite"
                />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="min-w-0" aria-labelledby="macos-alternatives-title">
      <div class="flex items-center gap-3">
        <svg
          class="size-6 shrink-0 text-blue-600 dark:text-blue-400"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M16.4 13c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.1-1.7-1.3-.1-2.6.8-3.3.8s-1.8-.8-2.9-.8c-1.5 0-2.9.9-3.7 2.2-1.6 2.8-.4 6.9 1.1 9.1.8 1.1 1.7 2.3 2.9 2.3 1.1 0 1.6-.7 2.9-.7 1.4 0 1.8.7 3 .7 1.2 0 2-1.1 2.8-2.2.9-1.3 1.2-2.5 1.2-2.6 0-.1-2.8-1.1-2.8-3.7ZM14.4 6.5c.6-.8 1.1-1.9 1-3-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2-.5 2.7-1.3Z"
          ></path>
        </svg>
        <h2
          id="macos-alternatives-title"
          class="text-2xl font-bold text-neutral-900 dark:text-white"
        >
          Installing on a Mac
        </h2>
      </div>
      <p class="mt-3 max-w-prose text-neutral-600 dark:text-neutral-300">
        This build is integrity-checked but not Apple-notarized yet, so macOS may
        wrongly report it as damaged. One command handles everything: it picks the
        build matching your Mac, installs it, and clears that warning.
      </p>
      <h3 class="mt-5 font-semibold text-neutral-900 dark:text-white">
        Install or update in one command
      </h3>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
        Paste into Terminal and press Return. Works on both Apple Silicon and
        Intel Macs.
      </p>
      {/*
        This command is one ~590-character line. Left as `white-space: pre` it
        cannot shrink, so its min-content width drove the grid column to 3944px
        and blew the layout out on mobile. Wrapping keeps it inside the column;
        the copy button reads `data-copy-text`, not the rendered text, so the
        copied command is unaffected by where it visually breaks.
      */}
      <pre class="mt-3 min-w-0 overflow-x-auto rounded-xl bg-neutral-950 px-4 py-4 text-xs leading-5 break-all whitespace-pre-wrap text-white">
        <code>{macosInstallCommand}</code>
      </pre>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button
          type="button"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white transition duration-200 hover:bg-blue-700 focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden active:bg-blue-800 dark:focus-visible:ring-blue-800"
          style="background-color:#2563eb; color:#ffffff;"
          data-copy-command
          data-copy-text={macosInstallCommand}
          data-copy-success="Command copied. Paste it into Terminal and press Return."
          aria-label="Copy macOS install command"
          aria-describedby="macos-install-copy-status"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            ></path>
          </svg>
          <span data-copy-label>Copy command</span>
        </button>
        <p
          id="macos-install-copy-status"
          class="min-h-5 text-sm text-blue-800 dark:text-blue-200"
          aria-live="polite"
        >
        </p>
      </div>
      <p class="mt-5 text-sm text-neutral-600 dark:text-neutral-400">
        No <code>sudo</code> required. Safe to run again whenever you want the
        latest version &mdash; it replaces the installed copy in place.
      </p>
    </section>
  </div>
</div>
