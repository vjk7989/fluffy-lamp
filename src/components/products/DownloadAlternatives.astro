---
// HyperOx install commands. The signed install scripts live on the app source
// repo and verify the .minisig signature before unpacking. The copy buttons are
// wired by the script in src/pages/products/[id].astro (data-copy-* attributes).
const scriptsBase =
  'https://github.com/vjk7989/h0x-ADE-app/releases/latest/download';

const sections = [
  {
    id: 'windows',
    title: 'Windows',
    intro:
      'Windows 10/11 x64. Open PowerShell, copy a command and press Enter. The app installs to %LOCALAPPDATA%\Programs\h0x-ade and is added to PATH.',
    commands: [
      {
        label: 'PowerShell',
        description: 'Download and run the signed installer.',
        command: `powershell -c "irm ${scriptsBase}/install.ps1 | iex"`,
      },
      {
        label: 'curl.exe',
        description:
          'Download the installer with the curl that comes with Windows, then run it.',
        command: `curl.exe -fsSLo "$env:TEMP\\hyperox-install.ps1" ${scriptsBase}/install.ps1
powershell -ExecutionPolicy Bypass -File "$env:TEMP\\hyperox-install.ps1"`,
      },
    ],
  },
  {
    id: 'macos',
    title: 'macOS',
    intro:
      'Apple Silicon only. Intel Macs are not supported. The app installs to ~/Applications/HyperOx.app.',
    commands: [
      {
        label: 'Install',
        description: 'Download and run the signed installer in Terminal.',
        command: `curl -fsSL ${scriptsBase}/install.sh | sh`,
      },
      {
        label: 'Self-sign',
        description:
          'The installer already signs the app for you. Use this after a manual tarball download, or if macOS says the app is damaged.',
        command:
          'xattr -dr com.apple.quarantine ~/Applications/HyperOx.app && codesign --force --deep --sign - ~/Applications/HyperOx.app && open ~/Applications/HyperOx.app',
      },
    ],
  },
  {
    id: 'linux',
    title: 'Linux',
    intro:
      'x86_64 and aarch64. The installer adds a launcher entry.',
    commands: [
      {
        label: 'Install',
        description: 'Download and run the signed installer in a terminal.',
        command: `curl -fsSL ${scriptsBase}/install.sh | sh`,
      },
    ],
  },
];
---

<div class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
  <p class="max-w-prose text-neutral-600 dark:text-neutral-300">
    Prefer a command to a browser download? These installers check the release
    signature, then install the app and HyperOx core. You can also get the
    signed archives from the
    <a
      class="font-medium text-blue-600 underline underline-offset-4 dark:text-blue-400"
      href="https://github.com/buckleson/h0x-ADE-Releases/releases/latest"
      >releases page</a
    >.
  </p>
  <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
    {
      sections.map(section => (
        <section class="min-w-0" aria-labelledby={`${section.id}-alternatives-title`}>
          <h2
            id={`${section.id}-alternatives-title`}
            class="text-2xl font-bold text-neutral-900 dark:text-white"
          >
            {section.title}
          </h2>
          <p class="mt-3 max-w-prose text-neutral-600 dark:text-neutral-300">
            {section.intro}
          </p>
          <div class="mt-7 space-y-8">
            {section.commands.map((item, index) => {
              const statusId = `${section.id}-${index}-copy-status`;
              return (
                <div>
                  <h3 class="font-semibold text-neutral-900 dark:text-white">
                    {item.label}
                  </h3>
                  <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                    {item.description}
                  </p>
                  {/* whitespace-pre-wrap and overflow-wrap:anywhere keep long
                      commands inside the column on mobile. The copy button
                      reads data-copy-text, so wrapping does not change what is
                      copied. */}
                  <pre class="mt-3 min-w-0 overflow-x-auto rounded-xl bg-neutral-950 px-4 py-4 text-xs leading-5 whitespace-pre-wrap [overflow-wrap:anywhere] text-white">
                    <code>{item.command}</code>
                  </pre>
                  <div class="mt-3 flex flex-wrap items-center gap-3">
                    <button
                      type="button"
                      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white transition duration-200 hover:bg-blue-700 focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden active:bg-blue-800 dark:focus-visible:ring-blue-800"
                      style="background-color:#2563eb; color:#ffffff;"
                      data-copy-command
                      data-copy-text={item.command}
                      data-copy-success={`Command copied. Paste it into ${section.id === 'windows' ? 'PowerShell' : 'Terminal'} and press ${section.id === 'windows' ? 'Enter' : 'Return'}.`}
                      aria-label={`Copy ${section.title} ${item.label} command`}
                      aria-describedby={statusId}
                    >
                      <svg
                        class="size-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                      </svg>
                      <span data-copy-label>Copy command</span>
                    </button>
                    <p
                      id={statusId}
                      class="min-h-5 text-sm text-blue-800 dark:text-blue-200"
                      aria-live="polite"
                    />
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</div>
