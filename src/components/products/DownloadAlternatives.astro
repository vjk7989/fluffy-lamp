---
// HyperOx install commands. The signed install scripts live in the public
// releases repo and verify the .minisig signature before unpacking. The copy
// buttons are wired by the script in src/pages/products/[id].astro
// (data-copy-* attributes).
const releasesUrl = 'https://github.com/buckleson/h0x-ADE-Releases';
const scriptsBase = `${releasesUrl}/releases/latest/download`;

const sections = [
  {
    id: 'windows',
    title: 'Windows',
    intro:
      'Windows 10/11 x64. The app installs to %LOCALAPPDATA%\\Programs\\h0x-ade and is added to PATH.',
    steps: [
      'Open PowerShell.',
      'Copy a command below and press Enter.',
      'Open HyperOx from the Start menu, or run h0x-ade.',
    ],
    commands: [
      {
        label: 'PowerShell',
        description: 'Download and run the signed installer.',
        command: `powershell -c "irm ${scriptsBase}/install.ps1 | iex"`,
      },
      {
        label: 'curl.exe',
        description:
          'Download the installer with the curl that comes with Windows, then run it.',
        command: `curl.exe -fsSLo "$env:TEMP\\hyperox-install.ps1" ${scriptsBase}/install.ps1
powershell -ExecutionPolicy Bypass -File "$env:TEMP\\hyperox-install.ps1"`,
      },
    ],
  },
  {
    id: 'macos',
    title: 'macOS',
    intro:
      'Apple Silicon only. Intel Macs are not supported. The app installs to ~/Applications/HyperOx.app.',
    steps: [
      'Open Terminal.',
      'Copy the Install command and press Return.',
      'Open HyperOx from ~/Applications.',
    ],
    commands: [
      {
        label: 'Install',
        description: 'Download and run the signed installer in Terminal.',
        command: `curl -fsSL ${scriptsBase}/install.sh | sh`,
      },
      {
        label: 'Self-sign',
        description:
          'The installer already signs the app for you. Use this after a manual tarball download, or if macOS says the app is damaged.',
        command:
          'xattr -dr com.apple.quarantine ~/Applications/HyperOx.app && codesign --force --deep --sign - ~/Applications/HyperOx.app && open ~/Applications/HyperOx.app',
      },
    ],
  },
  {
    id: 'linux',
    title: 'Linux',
    intro: 'x86_64 and aarch64. The installer adds a launcher entry.',
    steps: [
      'Open a terminal.',
      'Copy the command and press Enter.',
      'Open HyperOx from your app launcher.',
    ],
    commands: [
      {
        label: 'Install',
        description: 'Download and run the signed installer in a terminal.',
        command: `curl -fsSL ${scriptsBase}/install.sh | sh`,
      },
    ],
  },
];
---

<div class="mx-auto max-w-6xl px-4 pb-14 text-left sm:px-6 lg:px-8">
  <p class="max-w-prose text-neutral-600 dark:text-neutral-300">
    Prefer a command to a browser download? These installers check the release
    signature, then install the app and HyperOx core. You can also get the
    signed files from
    <a
      class="font-medium text-blue-600 underline underline-offset-4 dark:text-blue-400"
      href={releasesUrl}>all downloads and releases on GitHub</a
    >.
  </p>
  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {
      sections.map(section => (
        <section
          class="min-w-0 rounded-2xl border border-neutral-200 bg-white/70 p-5 text-left sm:p-6 dark:border-neutral-700 dark:bg-neutral-900/60"
          aria-labelledby={`${section.id}-alternatives-title`}
        >
          <h2
            id={`${section.id}-alternatives-title`}
            class="text-2xl font-bold text-neutral-900 dark:text-white"
          >
            {section.title}
          </h2>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">
            {section.intro}
          </p>
          <div class="mt-4 rounded-xl bg-neutral-100 p-4 dark:bg-neutral-800/60">
            <p class="text-xs font-semibold tracking-wide text-neutral-500 uppercase dark:text-neutral-400">
              How to install
            </p>
            <ol class="mt-2 list-decimal space-y-1 ps-5 text-sm text-neutral-700 dark:text-neutral-300">
              {section.steps.map(step => <li>{step}</li>)}
            </ol>
          </div>
          <div class="mt-6 space-y-8">
            {section.commands.map((item, index) => {
              const statusId = `${section.id}-${index}-copy-status`;
              return (
                <div class="min-w-0">
                  <h3 class="font-semibold text-neutral-900 dark:text-white">
                    {item.label}
                  </h3>
                  <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                    {item.description}
                  </p>
                  {/* No whitespace between <pre>, <code> and the text: <pre>
                      keeps it, which indented the first line. The copy
                      button reads data-copy-text, so wrapping does not change
                      what is copied. */}
                  <pre class="mt-3 max-w-full rounded-xl bg-neutral-950 p-4 text-left text-xs leading-5 whitespace-pre-wrap text-white [overflow-wrap:anywhere]"><code>{item.command}</code></pre>
                  <div class="mt-3 flex flex-wrap items-center justify-start gap-3">
                    <button
                      type="button"
                      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white transition duration-200 hover:bg-blue-700 focus-visible:ring-3 focus-visible:ring-blue-300 focus-visible:outline-hidden active:bg-blue-800 dark:focus-visible:ring-blue-800"
                      style="background-color:#2563eb; color:#ffffff;"
                      data-copy-command
                      data-copy-text={item.command}
                      data-copy-success={`Command copied. Paste it into ${section.id === 'windows' ? 'PowerShell' : 'Terminal'} and press ${section.id === 'windows' ? 'Enter' : 'Return'}.`}
                      aria-label={`Copy ${section.title} ${item.label} command`}
                      aria-describedby={statusId}
                    >
                      <svg
                        class="size-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                      </svg>
                      <span data-copy-label>Copy command</span>
                    </button>
                    <p
                      id={statusId}
                      class="min-h-5 text-sm text-blue-800 dark:text-blue-200"
                      aria-live="polite"
                    />
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</div>
